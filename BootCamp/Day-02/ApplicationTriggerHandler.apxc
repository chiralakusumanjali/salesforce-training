public class ApplicationTriggerHandler {

    public static void beforeInsert(List<Application__c> newApplications){

        Set<Id> studentIds = new Set<Id>();
        Set<Id> jobIds = new Set<Id>();

        for(Application__c app : newApplications){

            if(app.Student__c != null){
                studentIds.add(app.Student__c);
            }

            if(app.Jobss__c != null){
                jobIds.add(app.Jobss__c);
            }
        }

        Map<Id, Student__c> studentMap = new Map<Id, Student__c>([
            SELECT Id,
                   CGPA__c
            FROM Student__c
            WHERE Id IN :studentIds
        ]);
        Map<Id, Jobss__c> jobMap = new Map<Id, Jobss__c>([
            SELECT Id,
                   Minimum_CGPA__c,
                   Last_Date__c
            FROM Jobss__c
            WHERE Id IN :jobIds
        ]);

        List<Application__c> existingApps = [
            SELECT Student__c,
                   Jobss__c
            FROM Application__c
            WHERE Student__c IN :studentIds
            AND Jobss__c IN :jobIds
        ];

        Set<String> existingPairs = new Set<String>();

        for(Application__c app : existingApps){

            existingPairs.add(app.Student__c + '-' + app.Jobss__c);

        }

        Set<String> currentPairs = new Set<String>();

        for(Application__c app : newApplications){

            Student__c student = studentMap.get(app.Student__c);

            Jobss__c job = jobMap.get(app.Jobss__c);

            String pair = app.Student__c + '-' + app.Jobss__c;

            if(existingPairs.contains(pair)){

                app.addError('Student has already applied for this job.');

            }

            if(currentPairs.contains(pair)){

                app.addError('Duplicate Application in same transaction.');

            }else{

                currentPairs.add(pair);

            }

            if(student != null && job != null){
                if(student.CGPA__c < job.Minimum_CGPA__c){

                    app.addError('Student CGPA is below minimum requirement.');

                }

                if(Date.today() > job.Last_Date__c){

                    app.addError('Application deadline has passed.');

                }

            }

            app.Stauts__c = 'Applied';

        }

    }

}